# Run coturn yourself; replace example values before starting it.
listening-port=3478
tls-listening-port=5349
realm=turn.your-domain.example
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_A_LONG_RANDOM_SECRET
cert=/etc/ssl/gather/fullchain.pem
pkey=/etc/ssl/gather/privkey.pem
min-port=49160
max-port=49200
# If behind NAT: external-ip=YOUR_PUBLIC_IP/YOUR_PRIVATE_IP
# listening-ip=YOUR_INTERFACE_IP
# relay-ip=YOUR_INTERFACE_IP
no-cli
no-multicast-peers
no-tlsv1
no-tlsv1_1
stale-nonce=600
user-quota=16
total-quota=128
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
