# Example: serve your own hostname over TLS. Replace every example path.
server {
    listen 80;
    server_name meet.your-domain.example;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name meet.your-domain.example;
    root /var/www/gather/public;
    index index.php;
    ssl_certificate /etc/ssl/gather/fullchain.pem;
    ssl_certificate_key /etc/ssl/gather/privkey.pem;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header Permissions-Policy 'camera=(self), microphone=(self), display-capture=(self)' always;
    add_header X-Frame-Options SAMEORIGIN always;
    charset utf-8;
    location / { try_files $uri $uri/ /index.php?$query_string; }
    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt { access_log off; log_not_found off; }
    error_page 404 /index.php;
    location ~ ^/index\.php(/|$) {
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
    }
    location ~ \.(php)$ { return 404; }
    location ~ /\.(?!well-known).* { deny all; }
}
